{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "backup": {
      "type": "object",
      "properties": {
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string"},
        "host": {"type": "string"},
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "claimName"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
              "claimName": {"type": "string", "minLength": 1},
              "include": {"type": "array", "items": {"type": "string"}},
              "exclude": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      },
      "required": ["schedule", "targets"]
    },
    "repository": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "retryLock": {"type": "string"}
      }
    },
    "integrityCheck": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["metadata", "subset", "full"]},
        "readDataSubset": {"type": "string"},
        "withCache": {"type": "boolean"}
      },
      "required": ["enabled", "schedule", "mode"]
    },
    "cache": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["emptyDir", "pvc"]}
      }
    },
    "integrityCache": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["emptyDir", "pvc"]}
      }
    }
  }
}
